# Postgres connection string.
# Local dev: run `npx prisma dev` and paste the DATABASE_URL it prints.
# Production: your Neon (or any Postgres) pooled connection string.
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Only needed locally for `prisma migrate dev` (Prisma Postgres prints this too).
SHADOW_DATABASE_URL=""

# Secret that signs the Callsign session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"
